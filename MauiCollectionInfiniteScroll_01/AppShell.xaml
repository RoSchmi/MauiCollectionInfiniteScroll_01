<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiCollectionInfiniteScroll_01.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiCollectionInfiniteScroll_01"
    xmlns:pages="clr-namespace:MauiCollectionInfiniteScroll_01.Pages"
    Title="MauiCollectionInfiniteScroll_01">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
    Title="DisplayPage"
    ContentTemplate="{DataTemplate pages:DisplayPage}"
    Route="DisplayPage" />
    
</Shell>
